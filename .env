# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://rce.localhost:8180
###< symfony/routing ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://rce:rce@database:5432/rce_main?serverVersion=18&charset=utf8"
# Conexión de arranque del EM de tenant: base inexistente a propósito (ver hakam_multi_tenancy.yaml)
TENANT_BOOT_DATABASE_URL="postgresql://rce:rce@database:5432/rce_no_tenant?serverVersion=18&charset=utf8"
TENANT_DB_HOST=database
TENANT_DB_PORT=5432
# Clave de las bases de tenant. En GCP viene de Secret Manager; nunca se guarda en tenant_db_config (docs/adr/0003)
TENANT_DB_PASSWORD=rce
# Dominio base para resolver el tenant por subdominio: <centro>.rce.localhost
TENANT_BASE_DOMAIN=rce.localhost
###< doctrine/doctrine-bundle ###

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
# Valkey (Memorystore for Valkey en GCP): locks de cobro y circuit breaker por proveedor.
REDIS_URL=redis://redis:6379
LOCK_DSN="${REDIS_URL}"
# Circuit breaker por proveedor: si en la ventana hubo al menos MIN_REQUESTS llamadas y fallaron
# FAILURE_RATE % o más, no se llama al proveedor durante PAUSE_SECONDS.
CIRCUIT_BREAKER_FAILURE_RATE=50
CIRCUIT_BREAKER_MIN_REQUESTS=5
CIRCUIT_BREAKER_WINDOW_SECONDS=30
CIRCUIT_BREAKER_PAUSE_SECONDS=60
# Webpay: timeout de cada llamada a Transbank, en segundos. La llaman workers, no la web.
WEBPAY_TIMEOUT_SECONDS=10
# IMED (SOAP): timeout de cada llamada, en segundos. La llaman workers, no la web.
IMED_TIMEOUT_SECONDS=10
###< symfony/lock ###

###> rce/cola ###
# Cola de encargos (Integration/Messaging). Ver src/Integration/Messaging/CLAUDE.md.
# Base de las llamadas a /_tasks. Local: el nginx de compose. GCP: la URL del servicio en Cloud Run.
TASKS_BASE_URL=http://nginx
# Solo local: token que comparte el simulador (contenedor tasks) con /_tasks. En prod no se usa.
TASKS_LOCAL_TOKEN=solo-desarrollo-cambiar-0123456789
# Solo GCP (Secret Manager / variables de Cloud Run). Audiencia del token OIDC: la URL del servicio.
TASKS_AUDIENCE=
CLOUD_TASKS_PROJECT=
CLOUD_TASKS_LOCATION=
CLOUD_TASKS_QUEUE=
CLOUD_TASKS_SERVICE_ACCOUNT=
###< rce/cola ###
