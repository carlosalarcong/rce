{% extends 'base.html.twig' %}

{% block title %}Recuperar contraseña · RCE{% endblock %}

{% block body %}
    <h1>¿Olvidaste tu contraseña?</h1>
    <p class="muted">Escribe el correo de tu cuenta y te enviaremos un enlace para elegir una nueva.</p>

    {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
        {{ form_row(form.email) }}
        <button type="submit">Enviar enlace</button>
    {{ form_end(form) }}

    <p class="muted"><a href="{{ path('identity_login') }}">Volver a iniciar sesión</a></p>
{% endblock %}
